# ═══════════════════════════════════════════════════════════════════════════
#  data/gui/components/tiled_window_panel.tfcgui
# ═══════════════════════════════════════════════════════════════════════════
component tiled_window_panel {
    type   = panel
    sprite = "GFX_tiled_window"
    size   = [0, 0]
    anchor = TL
    alpha  = 1.0
}

# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/version_label.tfcgui
component version_label {
    type       = label
    text       = "#ALPHA"
    font       = "hoi_26mbs"
    color      = [1.0, 0.9, 0.6]
    text_align = left
    size       = [200, 24]
    visible    = true
}

# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/mainmenu_panel_bottom.tfcgui
component mainmenu_panel_bottom {
    type   = panel
    sprite = "GFX_tiled_window"
    size   = [320, 450]
    anchor = CC
    pos    = [0, 0]
}

# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/mainmenu_panel_upperleft.tfcgui
component mainmenu_panel_upperleft {
    type   = panel
    size   = [256, 768]
    anchor = CL
    pos    = [0, -1]
}

component mainmenu_panel_lowerleft {
    type   = panel
    size   = [500, 250]
    anchor = LowerLeft
    pos    = [0, -1]
}

component mainmenu_panel_lowerright {
    type   = panel
    size   = [500, 250]
    anchor = LowerRight
    pos    = [0, -1]
}
# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/mainmenu_panel_upperright.tfcgui
component mainmenu_panel_upperright {
    type   = panel
    size   = [256, 768]
    anchor = CR
    pos    = [-256, -1]
}

# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/mainmenu_single_player.tfcgui
component mainmenu_single_player {
    type    = panel
    sprite  = "GFX_tiled_window"
    size    = [320, 395]
    anchor  = CC
    visible = false
}

# ─────────────────────────────────────────────────────────────────────────

# data/gui/components/frontend_game_logo.tfcgui
component frontend_game_logo {
    type   = sprite
    sprite = "GFX_frontend_game_logo"
	size = [256, 100]
    anchor = TL
}
