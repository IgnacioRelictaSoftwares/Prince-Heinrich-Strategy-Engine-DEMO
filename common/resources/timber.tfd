# ═══════════════════════════════════════════════════════════════════════════
#  common/resources/timber.tfd
#  Recursos madereros — Relicta History Engine
#
#  curved_timber_ratio:
#    De cada 1000 árboles del bosque, cuántos poseen la curvatura
#    natural útil para cuadernas, quillas y baos de construcción naval.
#    Este sub-recurso se genera automáticamente al cargar la partida
#    en menor cantidad según el ratio. Si se agota, no puedes construir
#    navíos de línea aunque tengas madera abundante.
#
#  regrowth_rate:
#    Porcentaje de la reserva total que se regenera por renewal_tick.
#    La madera PUEDE renovarse, pero los árboles con curvatura útil
#    tardan generaciones — de ahí el ratio separado.
#
#  Valores base en R8 (Reales de a Ocho)
# ═══════════════════════════════════════════════════════════════════════════

# ── Maderas de construcción general ──────────────────────────────────────

resource OAK_TIMBER {
    name               = "RESOURCE_OAK_TIMBER_NAME"
    desc               = "RESOURCE_OAK_TIMBER_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = DECADE
    renewal_rate       = 0.08
    regrowth_rate      = 0.06
    curved_timber_ratio = 0.04      # 40 árboles útiles por cada 1000
    base_value         = 6.0
}

resource PINE_TIMBER {
    name               = "RESOURCE_PINE_TIMBER_NAME"
    desc               = "RESOURCE_PINE_TIMBER_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = DECADE
    renewal_rate       = 0.12
    regrowth_rate      = 0.10
    curved_timber_ratio = 0.01      # Pino es casi recto, poco útil para curvas
    base_value         = 3.5
}

resource TEAK_TIMBER {
    name               = "RESOURCE_TEAK_TIMBER_NAME"
    desc               = "RESOURCE_TEAK_TIMBER_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = CENTURY
    renewal_rate       = 0.02
    regrowth_rate      = 0.015
    curved_timber_ratio = 0.06      # Excelente para construcción naval tropical
    base_value         = 14.0
}

# ── Maderas raras de alto valor naval ────────────────────────────────────

resource PATAGONIAN_LARCH {
    name               = "RESOURCE_PATAGONIAN_LARCH_NAME"
    desc               = "RESOURCE_PATAGONIAN_LARCH_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = CENTURY
    renewal_rate       = 0.001
    regrowth_rate      = 0.0008
    curved_timber_ratio = 0.00001   # Extremadamente raro — casi imposible de mantener
    base_value         = 45.0
}

resource SEQUOIA_TIMBER {
    name               = "RESOURCE_SEQUOIA_TIMBER_NAME"
    desc               = "RESOURCE_SEQUOIA_TIMBER_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = CENTURY
    renewal_rate       = 0.0005
    regrowth_rate      = 0.0003
    curved_timber_ratio = 0.00001   # Igual de raro — troncos demasiado rectos y enormes
    base_value         = 38.0
}

resource CEDRUS_TIMBER {
    name               = "RESOURCE_CEDRUS_TIMBER_NAME"
    desc               = "RESOURCE_CEDRUS_TIMBER_DESC"
    type               = STRATEGIC
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = CENTURY
    renewal_rate       = 0.003
    regrowth_rate      = 0.002
    curved_timber_ratio = 0.03
    base_value         = 22.0
}

# ── Maderas para uso general no naval ────────────────────────────────────

resource COMMON_TIMBER {
    name               = "RESOURCE_COMMON_TIMBER_NAME"
    desc               = "RESOURCE_COMMON_TIMBER_DESC"
    type               = COMMON
    sub_type           = WOOD
    isRenovable        = true
    renewal_tick       = YEARLY
    renewal_rate       = 0.20
    regrowth_rate      = 0.18
    curved_timber_ratio = 0.0       # Sin valor naval
    base_value         = 1.2
}
