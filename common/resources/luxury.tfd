# ── Metales preciosos ─────────────────────────────────────────────────────

resource SILVER_ORE {
    name         = "RESOURCE_SILVER_ORE_NAME"
    desc         = "RESOURCE_SILVER_ORE_DESC"
    type         = LUXURY
    sub_type     = PRECIOUS_METAL
    isRenovable  = false
    renewal_tick = CENTURY
    renewal_rate = 0.000001
    base_value   = 64.0             # Base de los propios R8
}

resource GOLD_ORE {
    name         = "RESOURCE_GOLD_ORE_NAME"
    desc         = "RESOURCE_GOLD_ORE_DESC"
    type         = LUXURY
