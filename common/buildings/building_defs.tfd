# ─── Categorías ──────────────────────────────────────────────────────────────

building_category EXTRACTION {
    name  = "BUILDING_CAT_EXTRACTION"
    icon  = "GFX_cat_extraction"
    color = { 180 120 60 }
}

building_category INFRASTRUCTURE {
    name  = "BUILDING_CAT_INFRASTRUCTURE"
    icon  = "GFX_cat_infrastructure"
    color = { 60 120 180 }
}

building_category MILITARY {
    name  = "BUILDING_CAT_MILITARY"
    icon  = "GFX_cat_military"
    color = { 180 60 60 }
}

building_category INDUSTRIAL {
    name  = "BUILDING_CAT_INDUSTRIAL"
    icon  = "GFX_cat_industrial"
    color = { 120 120 120 }
}

building_category CULTURAL {
    name  = "BUILDING_CAT_CULTURAL"
    icon  = "GFX_cat_cultural"
    color = { 120 60 180 }
}

building_category ADMINISTRATIVE {
    name  = "BUILDING_CAT_ADMINISTRATIVE"
    icon  = "GFX_cat_administrative"
    color = { 180 180 60 }
}

# ─── Minería — NITRATE ───────────────────────────────────────────────────────

building NITRATE_MINE_I {
    name        = "BUILDING_NITRATE_MINE_I"
    desc        = "BUILDING_NITRATE_MINE_I_DESC"
    category    = EXTRACTION
    placement   = PROVINCE
    max_level   = 1
    upgrades_to = NITRATE_MINE_II

    requires_resource = SALTPETER
    allowed_terrain   = [ desert coastal_hills mountain coastal_flat ]

    construction_cost = {
        TIME_DAYS = 180
    }

    maintenance = { GOLD = 15.0 }

    exploitation = {
        resource   = SALTPETER
        rate       = 0.03
        efficiency = 0.70
    }

    modifiers = {
        local_nitrate_output = 2.0
        local_employment     = 50.0
