# ─── Railroads ──────────────────────────────────────────────────────────────

tech RAILWAY_EXPANSION {
	name = "TECH_RAILWAY_EXPANSION_NAME"
	desc = "TECH_RAILWAY_EXPANSION_DESC"
	category = INFRASTRUCTURE
	era = INDUSTRIAL_ERA_1
	base_cost = 500.0
	start_tech = yes

	effect {
		railway_building_speed = 0.15
		infrastructure_growth = 0.10
		trade_capacity = 0.10
	}

	unlocks {
		MOUNTAIN_RAILWAYS
		RAILWAY_STANDARDIZATION
	}
}

tech MOUNTAIN_RAILWAYS {
	name = "TECH_MOUNTAIN_RAILWAYS_NAME"
	desc = "TECH_MOUNTAIN_RAILWAYS_DESC"
	category = INFRASTRUCTURE
	era = INDUSTRIAL_ERA_2
	base_cost = 800.0
	prerequisites = [ RAILWAY_EXPANSION MOUNTAIN_WARFARE_EXPERTS ]

	effect {
		mountain_province_infrastructure = 0.25
		mining_output_remote = 0.15
		trade_capacity = 0.10
	}
}

tech RAILWAY_STANDARDIZATION {
	name = "TECH_RAILWAY_STANDARDIZATION_NAME"
	desc = "TECH_RAILWAY_STANDARDIZATION_DESC"
	category = INFRASTRUCTURE
	era = INDUSTRIAL_ERA_2
	base_cost = 600.0
	prerequisites = [ RAILWAY_EXPANSION ]

	effect {
		railway_maintenance = -0.15
		trade_capacity = 0.15
		railway_building_cost = -0.10
	}

	unlocks {
		TRANSANDINE_RAILWAY
	}
}

tech TRANSANDINE_RAILWAY {
	name = "TECH_TRANSANDINE_RAILWAY_NAME"
	desc = "TECH_TRANSANDINE_RAILWAY_DESC"
	category = INFRASTRUCTURE
	era = INDUSTRIAL_ERA_3
	base_cost = 1500.0
	prerequisites = [ MOUNTAIN_RAILWAYS RAILWAY_STANDARDIZATION ]

	effect {
		international_trade = 0.25
		diplomatic_relations_ARG = 0.15
		economic_growth = 0.10
	}
}

